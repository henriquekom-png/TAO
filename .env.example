# Copie este ficheiro para ".env" na raiz do projeto e preencha.
# O ficheiro ".env" está no .gitignore — não faça commit de credenciais.
#
# Use a mesma connection string PostgreSQL que em .streamlit/secrets.toml (SUPABASE_DB_URL).

SUPABASE_DB_URL=postgresql://postgres.SUA_REF:SUA_SENHA@db.SUA_REF.supabase.co:5432/postgres
