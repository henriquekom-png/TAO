# Copie este ficheiro para ".env" na raiz do projeto e preencha.
# O ficheiro ".env" está no .gitignore — não faça commit de credenciais.
#
# Use a mesma connection string PostgreSQL que em .streamlit/secrets.toml (SUPABASE_DB_URL).

SUPABASE_DB_URL=postgresql://postgres.SUA_REF:SUA_SENHA@db.SUA_REF.supabase.co:5432/postgres

# ── FastAPI backend ────────────────────────────────────────────────────────────
# PostgreSQL direct connection (used by asyncpg pool in backend/app/database.py)
# Can be the same value as SUPABASE_DB_URL above.
DATABASE_URL=postgresql://postgres.SUA_REF:SUA_SENHA@db.SUA_REF.supabase.co:5432/postgres

# Pool sizing (optional — defaults work for Supabase free tier)
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# ── Gemini / AI service ────────────────────────────────────────────────────────
# Used by backend/app/services/ai_service.py (google.genai v1.0+ SDK)
GEMINI_API_KEY=AIza...

# Override the default model if desired (optional)
# GEMINI_MODEL=gemini-2.5-flash
